page {
  min-height: 100%;
  background: #fff7e8;
  color: #3b2116;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;

  --color-page: #fff7e8;
  --color-surface: #fffdf7;
  --color-surface-subtle: #f8ecd5;
  --color-text: #3b2116;
  --color-text-muted: #80614d;
  --color-border: #dfc9a7;
  --color-accent: #c93d24;
  --color-accent-strong: #9f2d1b;
  --color-accent-soft: #f9ddd0;
  --color-jade: #168c88;
  --color-gold: #f6b916;
  --color-wood: #542b18;
  --color-danger: #b72f25;
  --space-1: 8rpx;
  --space-2: 16rpx;
  --space-3: 24rpx;
  --space-4: 32rpx;
  --space-6: 48rpx;
  --space-8: 64rpx;
  --radius-sm: 18rpx;
  --radius-md: 26rpx;
  --radius-lg: 34rpx;
  --shadow-card: 0 12rpx 26rpx rgba(84, 43, 24, 0.12), 0 2rpx 0 rgba(84, 43, 24, 0.06);
}

button { box-sizing: border-box; }
.primary-button,
.upload-button,
.new-button {
  border: 3rpx solid #7b351f !important;
  border-radius: 16rpx !important;
  background: linear-gradient(180deg, #dc5032 0%, #bd351f 100%) !important;
  color: #fff !important;
  font-weight: 750 !important;
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,.32), 0 5rpx 0 #7b351f !important;
}
.primary-button::after,
.upload-button::after,
.new-button::after { border: 0; }
.segmented,
.tabs {
  border: 2rpx solid #c8a87f !important;
  background: #ead9bd !important;
  box-shadow: inset 0 2rpx 5rpx rgba(84,43,24,.09);
}
.segment,
.tab { color: #765943 !important; }
.segment.active,
.tab.active {
  background: #fffaf0 !important;
  color: #9f2d1b !important;
  box-shadow: 0 4rpx 10rpx rgba(84,43,24,.13) !important;
}
.upload-card,
.card,
.recent-section,
.sheet-card,
.status-card,
.usage-card,
.profile-card,
.stats-card,
.setting-card,
.inventory-card {
  border: 3rpx solid #d9bd94 !important;
  background: #fffdf7;
}
.upload-card { border-color: #8c512f !important; box-shadow: inset 0 0 0 3rpx #edcf9f, var(--shadow-card) !important; }
.workshop-assistant { flex: none; width: 110rpx; height: 110rpx; }
.choice { border: 2rpx solid #d3b994 !important; background: #fffaf0; color: #765943 !important; }
.choice.selected { border-color: #168c88 !important; background: #e5f4ed !important; color: #106f6c !important; box-shadow: inset 0 0 0 2rpx rgba(22,140,136,.11); }
.label { color: #755742 !important; }
.name-input,
.text-input,
.picker-value { border: 2rpx solid #d3b994 !important; background: #fffaf0 !important; }
.library-card { border: 3rpx solid #d9bd94 !important; background: #fffdf7 !important; }
.library-card image { background: #f8ecd5 !important; }
.cover-empty { background: repeating-linear-gradient(45deg,#f8ecd5,#f8ecd5 12rpx,#fff7e8 12rpx,#fff7e8 24rpx) !important; color: #80614d !important; }
.library-status { border: 2rpx solid #b88853; border-radius: 8rpx !important; background: #fff0cb !important; color: #7a3d20 !important; }
.back-library { color: #a73522 !important; font-weight: 700; }
.eyebrow { color: #b43b24 !important; }
.status-button,
.outline-button,
.undo-button,
.quantity-editor button {
  border: 2rpx solid #d3b994 !important;
  background: #fffaf0 !important;
  color: #765943 !important;
}
.status-button.selected {
  border-color: #168c88 !important;
  background: #e5f4ed !important;
  color: #106f6c !important;
}
.status-button.completed.selected {
  border-color: #b88823 !important;
  background: #fff0bd !important;
  color: #7a5110 !important;
}
.rename {
  border: 2rpx solid #c59e73 !important;
  background: #fffaf0 !important;
  color: #9f2d1b !important;
}
.vault-icon,
.assistant-mark,
.setting-icon,
.avatar { border: 2rpx solid #d9bd94 !important; background: #f9ddd0 !important; }
.editor-mask { background: rgba(48,24,14,.58) !important; }
.editor-mask .sheet-card {
  border: 5rpx solid #6f3820 !important;
  border-bottom: 0 !important;
  background: #fff8e8 !important;
  box-shadow: inset 0 0 0 4rpx #d9aa69 !important;
}
.vault-active { background: #e5f4ed !important; }
.vault-current,
.quantity { color: #168c88 !important; }
.replenishment-section { border: 3rpx solid #d9bd94 !important; background: #fff8e8 !important; }
.replenishment-count { border: 2rpx solid #d39c20; background: #fff0bd !important; color: #7a5110 !important; }
.inventory-card { overflow: hidden; }
.inventory-card .color-swatch { border-bottom: 3rpx solid #d9bd94; }
.profile-card { border-color: #7b351f !important; background: linear-gradient(145deg,#d94b2c,#ad2f20) !important; color: #fff7e8; box-shadow: inset 0 0 0 4rpx #eaa35e,var(--shadow-card) !important; }
.profile-card .title,
.profile-card .copy,
.profile-card .eyebrow { color: #fff7e8 !important; }
.stats-card .stat-number { color: #c93d24 !important; font-family: ui-monospace, SFMono-Regular, Consolas, monospace; }
.clear-button { border: 2rpx solid #d79a8c !important; background: #fff8f1 !important; }

/* Compact wooden tags for secondary page actions. */
.library-head .new-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx !important;
  min-width: 112rpx !important;
  height: 78rpx !important;
  margin: 2rpx 0 0 !important;
  padding: 0 !important;
  border: 3rpx solid #71331f !important;
  border-radius: 22rpx !important;
  font-size: 23rpx !important;
  line-height: 1 !important;
  letter-spacing: 1rpx;
  box-shadow: inset 0 3rpx 0 rgba(255,255,255,.28), 0 5rpx 0 #71331f !important;
}
.hero .rename {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx !important;
  margin: 0 !important;
  padding: 0 !important;
  border: 3rpx solid #9a6541 !important;
  border-radius: 18rpx !important;
  background: linear-gradient(180deg,#fffdf7,#f3dfbd) !important;
  color: #8f321f !important;
  font-size: 22rpx !important;
  font-weight: 750 !important;
  line-height: 1 !important;
  box-shadow: inset 0 2rpx 0 #fff, 0 4rpx 0 #9a6541 !important;
}
.hero .rename { width: 108rpx !important; min-width: 108rpx !important; }
.library-head .new-button:active,
.hero .rename:active {
  transform: translateY(3rpx);
  box-shadow: inset 0 2rpx 0 rgba(255,255,255,.22), 0 1rpx 0 #71331f !important;
}

.filter-result {
  display: block;
  margin-top: 6rpx;
  color: #80614d;
  font-size: 20rpx;
}
.inventory-filters {
  margin-top: 20rpx;
  padding: 22rpx;
  border: 3rpx solid #d9bd94;
  border-radius: 24rpx;
  background: #fffdf7;
  box-shadow: 0 8rpx 18rpx rgba(84,43,24,.08);
}
.filter-label {
  display: block;
  color: #654633;
  font-size: 22rpx;
  font-weight: 750;
}
.sort-button-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0,1fr));
  gap: 10rpx;
  margin-top: 14rpx;
}
.sort-button,
.filter-chip,
.letter-button,
.filter-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border: 2rpx solid #d3b994;
  background: #fffaf0;
  color: #765943;
  font-weight: 700;
  line-height: 1;
}
.sort-button::after,
.filter-chip::after,
.letter-button::after,
.filter-clear::after { border: 0; }
.sort-button {
  min-width: 0;
  height: 62rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
}
.sort-button.selected,
.filter-chip.selected,
.letter-button.selected {
  border-color: #168c88;
  background: #e5f4ed;
  color: #106f6c;
  box-shadow: inset 0 0 0 2rpx rgba(22,140,136,.1);
}
.filter-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 26rpx;
}
.filter-clear {
  width: auto;
  height: 48rpx;
  padding: 0 15rpx;
  border-color: #d79a8c;
  border-radius: 13rpx;
  background: #fff0ea;
  color: #a43124;
  font-size: 19rpx;
}
.filter-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}
.filter-chip {
  width: calc((100% - 20rpx) / 3);
  height: 58rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
}
.letter-label { margin-top: 26rpx; }
.letter-scroll { width: 100%; margin-top: 14rpx; white-space: nowrap; }
.letter-row { display: inline-flex; gap: 10rpx; padding-bottom: 2rpx; }
.letter-button {
  flex: none;
  width: 62rpx;
  height: 58rpx;
  border-radius: 14rpx;
  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
  font-size: 22rpx;
}
.letter-button:first-child { width: 86rpx; font-family: inherit; font-size: 20rpx; }

.view-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  flex: none;
  border-radius: 13rpx;
}
.view-toggle:active { background: #f1dfc4; }
.view-toggle-icon {
  display: grid;
  grid-template-columns: repeat(2, 9rpx);
  grid-template-rows: repeat(2, 9rpx);
  gap: 5rpx;
  width: 23rpx;
  height: 23rpx;
}
.view-toggle-icon > view {
  box-sizing: border-box;
  border: 3rpx solid #8f5635;
  border-radius: 3rpx;
}
.view-toggle-icon.detail {
  grid-template-columns: 23rpx;
  grid-template-rows: repeat(4, 3rpx);
  gap: 4rpx;
}
.view-toggle-icon.detail > view {
  border: 0;
  border-radius: 3rpx;
  background: #8f5635;
}

/* One-line, horizontally scrollable inventory filter rails. */
.inventory-filters {
  padding: 8rpx 14rpx;
  overflow: hidden;
}
.filter-row {
  display: flex;
  align-items: center;
  min-height: 68rpx;
  border-bottom: 1rpx solid #ead9bd;
}
.filter-row:last-child { border-bottom: 0; }
.filter-row .filter-label {
  flex: none;
  width: 112rpx;
  margin: 0;
  font-size: 21rpx;
  white-space: nowrap;
}
.filter-scroll {
  flex: 1;
  width: 0;
  white-space: nowrap;
}
.filter-inline {
  display: inline-flex;
  align-items: center;
  gap: 9rpx;
  padding: 7rpx 12rpx 7rpx 0;
}
.inventory-filters .sort-button,
.inventory-filters .filter-chip,
.inventory-filters .letter-button {
  flex: none;
  width: auto;
  min-width: 76rpx;
  height: 48rpx;
  padding: 0 15rpx;
  border-radius: 12rpx;
  font-size: 19rpx;
}
.inventory-filters .sort-button { min-width: 104rpx; }
.inventory-filters .letter-button {
  min-width: 48rpx;
  padding: 0 13rpx;
  font-size: 20rpx;
}
.inventory-filters .letter-button:first-child {
  width: auto;
  min-width: 76rpx;
  font-size: 19rpx;
}

.inventory-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  height: 74rpx;
  margin-top: 16rpx;
  color: #80614d;
  font-size: 21rpx;
}
.loading-beads { display: flex; align-items: center; gap: 7rpx; height: 30rpx; }
.loading-beads > view {
  width: 15rpx;
  height: 15rpx;
  border: 2rpx solid #71331f;
  border-radius: 50%;
  background: #c93d24;
  animation: inventory-bead-bounce .8s ease-in-out infinite alternate;
}
.loading-beads > view:nth-child(2) { background: #f6b916; animation-delay: .14s; }
.loading-beads > view:nth-child(3) { background: #168c88; animation-delay: .28s; }
.inventory-grid.is-loading { opacity: .32; pointer-events: none; }
@keyframes inventory-bead-bounce {
  from { transform: translateY(5rpx); }
  to { transform: translateY(-6rpx); }
}

.library-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.new-button{flex:none;margin:4rpx 0 0;padding:0 22rpx;border-radius:99rpx;background:#2d6f9f;color:#fff;font-size:23rpx}.new-button::after,.back-library::after{border:0}.library-waterfall{display:flex;align-items:flex-start;gap:20rpx;margin-top:30rpx}.library-column{flex:1;min-width:0}.library-card{overflow:hidden;margin-bottom:20rpx;border:1rpx solid var(--color-border);border-radius:22rpx;background:#fff;box-shadow:var(--shadow-card)}.library-card image{display:block;width:100%;min-height:190rpx;background:#f1f4f6}.cover-empty{display:flex;align-items:center;justify-content:center;height:220rpx;background:#edf3f6;color:#718492;font-size:22rpx}.library-copy{padding:18rpx}.library-status,.library-name,.library-meta{display:block}.library-status{width:fit-content;margin-bottom:8rpx;padding:4rpx 9rpx;border-radius:99rpx;background:#e7f2f8;color:#245f87;font-size:18rpx;font-weight:700}.library-name{overflow:hidden;color:var(--color-text);font-size:26rpx;font-weight:700;text-overflow:ellipsis;white-space:nowrap}.library-meta{margin-top:8rpx;color:var(--color-text-muted);font-size:20rpx}.library-empty{display:flex;flex-direction:column;align-items:center;padding:130rpx 40rpx 0;text-align:center}.library-empty>image{width:180rpx;height:180rpx}.library-empty .section-title{margin-top:20rpx}.library-empty .primary-button{width:100%}.back-library{margin:0 0 22rpx;padding:0;background:transparent;color:#315b77;font-size:25rpx;text-align:left}
