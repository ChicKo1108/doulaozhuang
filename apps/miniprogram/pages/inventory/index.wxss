.page { min-height: 100vh; padding: 32rpx 28rpx 48rpx; background: #fff9f0; }
.create-state { display: flex; flex-direction: column; align-items: center; padding: 176rpx 52rpx 0; text-align: center; }
.vault-icon { display: flex; align-items: center; justify-content: center; width: 136rpx; height: 136rpx; border-radius: 42rpx; background: #ead6c0; color: #6b4e3d; font-size: 66rpx; }
.title,.copy,.eyebrow,.code,.meta { display: block; }
.title { margin-top: 24rpx; color: #3b2d24; font-size: 42rpx; font-weight: 700; }
.copy { margin-top: 16rpx; color: #887c72; font-size: 27rpx; line-height: 1.65; }
.primary-button { margin-top: 34rpx; border-radius: 16rpx; background: #694c3a; color: #fff; font-size: 28rpx; }
.primary-button::after,.add-button::after { border: 0; }
.header-card { padding: 38rpx; border-radius: 26rpx; background: #694c3a; color: #fff9f0; }
.header-card .title { color: #fff; }
.header-card .copy { color: #eadbcf; }
.eyebrow { color: #e3b88c; font-size: 23rpx; letter-spacing: 4rpx; }
.add-button { margin: 26rpx 0 0; padding: 0 26rpx; border-radius: 14rpx; background: #d99b55; color: #fff; font-size: 26rpx; }
.inventory-list { margin-top: 24rpx; overflow: hidden; border-radius: 22rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(84,57,39,.06); }
.inventory-item { display: flex; align-items: center; min-height: 104rpx; padding: 0 26rpx; border-bottom: 1rpx solid #f1e9e1; }
.color-dot { width: 34rpx; height: 34rpx; margin-right: 18rpx; border: 1rpx solid rgba(0,0,0,.1); border-radius: 50%; }
.code { color: #3b2d24; font-size: 29rpx; font-weight: 700; }.meta { margin-top: 5rpx; color: #887c72; font-size: 23rpx; }.quantity { margin-left: auto; color: #694c3a; font-size: 27rpx; font-weight: 700; }
.editor-mask { position: fixed; z-index: 10; right: 0; bottom: 0; left: 0; top: 0; display: flex; align-items: flex-end; background: rgba(35,25,18,.44); }
.editor-card { width: 100%; padding: 38rpx 32rpx 56rpx; border-radius: 32rpx 32rpx 0 0; background: #fffdf9; }
.editor-title-row { display: flex; align-items: center; justify-content: space-between; }.editor-title { color: #3b2d24; font-size: 36rpx; font-weight: 700; }.close { color: #887c72; font-size: 52rpx; line-height: 1; }
.label { display: block; margin: 26rpx 0 10rpx; color: #776a60; font-size: 25rpx; }.picker-value,.text-input { padding: 20rpx; border-radius: 16rpx; background: #f7f0e7; color: #3b2d24; font-size: 28rpx; }.picker-value text { float: right; }
.quick-quantities { display: flex; gap: 14rpx; margin-top: 16rpx; }.quick-item { padding: 12rpx 17rpx; border-radius: 999rpx; background: #f2e8dd; color: #75695f; font-size: 24rpx; }.active-quick { background: #694c3a; color: #fff; }
