.page { min-height: 100vh; padding: 40rpx 28rpx 56rpx; background: var(--color-page); }.title,.copy,.eyebrow,.section-title,.section-copy,.code,.meta,.quantity-label,.quantity,.editor-title,.editor-note,.vault-name,.vault-meta,.item-code,.operation-change,.operation-time { display: block; }
.create-state { display:flex; flex-direction:column; align-items:center; padding:160rpx 52rpx 0; text-align:center; }.vault-icon { display:flex; align-items:center; justify-content:center; width:132rpx; height:132rpx; border:1rpx solid #dce5ff; border-radius:40rpx; background:var(--color-accent-soft); }.vault-icon image { width:64rpx; height:64rpx; }.eyebrow { color:var(--color-accent); font-size:22rpx; font-weight:700; letter-spacing:3rpx; }.create-state .eyebrow { margin-top:30rpx; }.title { margin-top:12rpx; color:var(--color-text); font-size:48rpx; font-weight:700; letter-spacing:-1rpx; }.copy { margin-top:14rpx; color:var(--color-text-muted); font-size:26rpx; line-height:1.65; }.login-error { margin-top:18rpx; color:var(--color-danger); font-size:23rpx; }
.primary-button,.outline-button,.mode-button { border-radius:var(--radius-sm); font-size:28rpx; font-weight:600; }.primary-button { height:88rpx; margin-top:36rpx; padding:0 36rpx; background:var(--color-accent); color:#fff; }.primary-button::after,.outline-button::after,.mode-button::after,.quantity-editor button::after,.undo-button::after { border:0; }
.page-heading { margin:0 8rpx; }.vault-select { display:flex; align-items:center; gap:12rpx; }.vault-select image { width:34rpx; height:34rpx; }.replenishment-section { margin-top:28rpx; padding:26rpx; border:1rpx solid #fde4b7; border-radius:var(--radius-md); background:#fffaf0; }.section-heading,.inventory-toolbar,.toolbar-actions,.history-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; }.section-title { color:var(--color-text); font-size:30rpx; font-weight:700; }.section-copy { margin-top:7rpx; color:var(--color-text-muted); font-size:22rpx; }.replenishment-count { display:flex; align-items:center; justify-content:center; min-width:44rpx; height:44rpx; border-radius:999rpx; background:#fff0d1; color:#9a6700; font-size:24rpx; font-weight:700; }.replenishment-list { margin-top:20rpx; }.replenishment-item { display:flex; align-items:center; min-height:66rpx; border-top:1rpx solid #f5e5c8; }.replenishment-dot { width:24rpx; height:24rpx; margin-right:12rpx; border:3rpx solid #fff; border-radius:50%; box-shadow:0 0 0 1rpx rgba(15,23,42,.12); }.replenishment-code { color:var(--color-text); font-size:26rpx; font-weight:700; }.replenishment-quantity { margin-left:auto; color:var(--color-text-muted); font-size:23rpx; }.replenishment-status { margin-left:14rpx; padding:5rpx 12rpx; border-radius:999rpx; font-size:20rpx; font-weight:700; }.replenishment-status.suggested { background:#fff0d1; color:#9a6700; }.replenishment-status.urgent { background:#fee2e2; color:#b42318; }.replenishment-empty { margin-top:18rpx; padding-top:18rpx; border-top:1rpx solid #f5e5c8; color:#718096; font-size:24rpx; }
.inventory-toolbar { margin-top:36rpx; }.sort-picker { display:flex; align-items:center; gap:6rpx; padding:14rpx 16rpx; border:1rpx solid var(--color-border); border-radius:999rpx; background:var(--color-surface); color:var(--color-text-muted); font-size:23rpx; }.sort-picker image { width:26rpx; height:26rpx; }.mode-button { height:56rpx; margin:0; padding:0 16rpx; border:1rpx solid #ccd8ff; background:var(--color-accent-soft); color:var(--color-accent); font-size:22rpx; }.inventory-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:20rpx; margin-top:20rpx; }.inventory-grid-compact { grid-template-columns:repeat(4,minmax(0,1fr)); gap:12rpx; }.inventory-card { overflow:hidden; border:1rpx solid var(--color-border); border-radius:var(--radius-md); background:var(--color-surface); box-shadow:var(--shadow-card); }.color-swatch { height:128rpx; }.inventory-detail { padding:20rpx; }.code { color:var(--color-text); font-size:30rpx; font-weight:700; }.meta { margin-top:6rpx; overflow:hidden; color:var(--color-text-muted); font-size:21rpx; text-overflow:ellipsis; white-space:nowrap; }.quantity-row { display:flex; align-items:baseline; justify-content:space-between; margin-top:22rpx; }.quantity-label { color:var(--color-text-muted); font-size:21rpx; }.quantity { color:var(--color-accent); font-size:26rpx; font-weight:700; }.inventory-grid-compact .color-swatch { height:88rpx; }.inventory-grid-compact .inventory-detail { padding:14rpx; }.inventory-grid-compact .code { font-size:25rpx; }.inventory-grid-compact .meta,.inventory-grid-compact .quantity-label { display:none; }.inventory-grid-compact .quantity-row { margin-top:8rpx; }.inventory-grid-compact .quantity { font-size:20rpx; }
.editor-mask { position:fixed; z-index:10; inset:0; display:flex; align-items:flex-end; background:rgba(15,23,42,.36); }.sheet-card { width:100%; max-height:88vh; padding:36rpx 32rpx 56rpx; overflow-y:auto; border-radius:36rpx 36rpx 0 0; background:#fff; }.editor-title-row { display:flex; align-items:center; justify-content:space-between; }.editor-title { color:var(--color-text); font-size:36rpx; font-weight:700; }.editor-note { margin-top:8rpx; color:var(--color-text-muted); font-size:23rpx; }.close { width:48rpx; height:48rpx; }.label { display:block; margin:26rpx 0 10rpx; color:var(--color-text-muted); font-size:25rpx; font-weight:600; }.picker-value,.text-input { display:flex; align-items:center; justify-content:space-between; padding:21rpx; border:1rpx solid var(--color-border); border-radius:var(--radius-sm); background:#fbfcfe; color:var(--color-text); font-size:28rpx; }.picker-value image { width:28rpx; height:28rpx; }.editor-action { width:100%; }
.vault-list { margin-top:26rpx; overflow:hidden; border:1rpx solid var(--color-border); border-radius:var(--radius-sm); }.vault-row { display:flex; align-items:center; justify-content:space-between; padding:22rpx; border-bottom:1rpx solid var(--color-border); }.vault-row:last-child { border-bottom:0; }.vault-active { background:var(--color-accent-soft); }.vault-name { color:var(--color-text); font-size:28rpx; font-weight:700; }.vault-meta { margin-top:6rpx; color:var(--color-text-muted); font-size:22rpx; }.vault-current { color:var(--color-accent); font-size:22rpx; font-weight:700; }.outline-button { width:100%; height:76rpx; margin-top:22rpx; border:1rpx solid #ccd8ff; background:#fff; color:var(--color-accent); }.vault-management { display:flex; justify-content:space-between; margin-top:26rpx; color:var(--color-text-muted); font-size:23rpx; }.danger-link { color:var(--color-danger); }
.item-summary { display:flex; align-items:center; gap:18rpx; margin-top:28rpx; padding:20rpx; border-radius:var(--radius-sm); background:var(--color-surface-subtle); }.item-swatch { width:70rpx; height:70rpx; border-radius:18rpx; }.item-code { color:var(--color-text); font-size:32rpx; font-weight:700; }.quantity-editor { display:flex; align-items:center; gap:12rpx; }.quantity-editor button { width:112rpx; height:76rpx; margin:0; padding:0; border-radius:var(--radius-sm); background:var(--color-accent-soft); color:var(--color-accent); font-size:23rpx; }.quantity-editor input { flex:1; height:74rpx; border:1rpx solid var(--color-border); border-radius:var(--radius-sm); color:var(--color-text); font-size:30rpx; text-align:center; }.history-heading { margin-top:38rpx; }.operation-list { margin-top:14rpx; }.operation-row { display:flex; align-items:center; justify-content:space-between; padding:18rpx 0; border-bottom:1rpx solid var(--color-border); }.operation-change { color:var(--color-text); font-size:25rpx; }.operation-time { margin-top:5rpx; color:var(--color-text-muted); font-size:20rpx; }.undo-button { margin:0; padding:8rpx 16rpx; border:1rpx solid #ccd8ff; border-radius:999rpx; background:#fff; color:var(--color-accent); font-size:22rpx; }.undone-text { color:var(--color-text-muted); font-size:22rpx; }
