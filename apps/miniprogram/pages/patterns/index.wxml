<view class="page"><view wx:if="{{!isLoggedIn}}" class="login-gate"><view class="assistant-mark"><image src="/assets/brand/zhuangdoudou-transparent-v1.webp" mode="aspectFit"/></view><text class="section-title">请先登录</text><text class="section-caption">登录后即可生成并保存图纸。</text><button class="primary-button" bindtap="retryLogin">微信登录</button></view><block wx:else><block wx:if="{{mode==='library'}}"><view class="library-head"><view><text class="eyebrow">我的图纸夹</text><text class="title">图纸库</text><text class="subtitle">未拼、正在拼和已经完成的作品都在这里。</text></view><button class="new-button" bindtap="showCreator">＋ 新建</button></view><view wx:if="{{leftPatterns.length||rightPatterns.length}}" class="library-waterfall"><view class="library-column"><view wx:for="{{leftPatterns}}" wx:key="id" class="library-card" data-id="{{item.id}}" bindtap="openPattern"><image wx:if="{{item.coverPath}}" src="{{item.coverPath}}" mode="widthFix"/><view wx:else class="cover-empty">暂无预览</view><view class="library-copy"><text class="library-status">{{item.statusLabel}}</text><text class="library-name">{{item.name}}</text><text class="library-meta">{{item.width||item.gridSize}}×{{item.height||item.gridSize}} · {{item.totalBeads}} 颗</text></view></view></view><view class="library-column"><view wx:for="{{rightPatterns}}" wx:key="id" class="library-card" data-id="{{item.id}}" bindtap="openPattern"><image wx:if="{{item.coverPath}}" src="{{item.coverPath}}" mode="widthFix"/><view wx:else class="cover-empty">暂无预览</view><view class="library-copy"><text class="library-status">{{item.statusLabel}}</text><text class="library-name">{{item.name}}</text><text class="library-meta">{{item.width||item.gridSize}}×{{item.height||item.gridSize}} · {{item.totalBeads}} 颗</text></view></view></view></view><view wx:else class="library-empty"><image src="/assets/brand/zhuangdoudou-transparent-v1.webp" mode="aspectFit"/><text class="section-title">图纸夹还是空的</text><text class="section-caption">让庄豆豆帮你做第一张图纸。</text><button class="primary-button" bindtap="showCreator">创建第一张图纸</button></view></block><block wx:else><button class="back-library" bindtap="showLibrary">‹ 返回图纸库</button>
<view class="page-heading"><text class="eyebrow">庄豆豆制图间</text><text class="title">把灵感变成可拼的图纸</text><text class="subtitle">服务端按 MARD 221 色卡生成，细节、色号和颗数都替你核对。</text></view>
<view class="segmented"><view class="segment {{sourceType==='source_image'?'active':''}}" data-value="source_image" bindtap="setSourceType">照片 / 插画</view><view class="segment {{sourceType==='existing_pattern_image'?'active':''}}" data-value="existing_pattern_image" bindtap="setSourceType">已有图纸</view></view>
<view class="upload-card"><image class="workshop-assistant" src="{{stage==='analyzing'?'/assets/design-system/zhuangdoudou-analyzing.webp':'/assets/brand/zhuangdoudou-transparent-v1.webp'}}" mode="aspectFit"/><view class="upload-copy"><text class="upload-title">{{stage==='analyzing'?'庄豆豆正在分析…':stage==='error'?'没看清，再试一次':'选择一张图片'}}</text><text class="upload-note">{{sourceType==='existing_pattern_image'?'会识别格线并避开外围文字与水印':'支持 PNG、JPG 与 WebP，最大 10 MB'}}</text></view><button class="upload-button" bindtap="chooseImage" loading="{{stage==='analyzing'}}">{{sourcePath?'重选':'上传'}}</button></view>
<view wx:if="{{sourcePath}}" class="card source-card"><image class="source-image" src="{{sourcePath}}" mode="aspectFit" /></view>
<view wx:if="{{stage==='ready'||stage==='converting'||stage==='done'}}" class="card controls"><text class="section-title">图纸参数</text><text class="label">尺寸 · 推荐项带“荐”</text><view class="choice-row"><view wx:for="{{sizes}}" wx:key="width" class="choice {{targetWidth===item.width?'selected':''}}" data-value="{{item.width}}" bindtap="selectWidth">{{item.width}}×{{item.height}}<text wx:if="{{item.recommended}}"> 荐</text></view></view><text class="label">MARD 色档</text><view class="choice-row"><view wx:for="{{kits}}" wx:key="id" class="choice {{kitId===item.id?'selected':''}}" data-value="{{item.id}}" bindtap="selectKit">{{item.label}}</view></view><text class="label">细节处理</text><view class="choice-row"><view wx:for="{{presets}}" wx:key="id" class="choice {{preset===item.id?'selected':''}}" data-value="{{item.id}}" bindtap="selectPreset">{{item.name}}</view></view><view class="switch-row"><text>连通背景透明化</text><switch checked="{{removeBackground}}" bindchange="toggleBackground" color="#168c88" /></view><view class="switch-row"><view><text>烫印镜像</text><text class="hint">输出前整张水平镜像</text></view><switch checked="{{mirror}}" bindchange="toggleMirror" color="#168c88" /></view><button class="primary-button" bindtap="generate" loading="{{stage==='converting'}}">{{stage==='converting'?'正在逐格配色…':'生成图纸'}}</button></view>
<view wx:if="{{result}}" class="card result-card"><view class="section-heading"><view><text class="section-title">施工结果</text><text class="section-caption">{{result.width}} × {{result.height}} 格 · {{result.colorCount}} 色 · {{result.totalBeads}} 颗</text></view><text class="mirror-badge" wx:if="{{result.mirror}}">已镜像</text></view><view class="segmented result-tabs"><view class="segment {{resultTab==='preview'?'active':''}}" data-value="preview" bindtap="setResultTab">成品预览</view><view class="segment {{resultTab==='construction'?'active':''}}" data-value="construction" bindtap="setResultTab">色号施工图</view></view><image class="result-image" src="{{resultTab==='preview'?previewPath:constructionPath}}" mode="widthFix" bindtap="previewAsset" /><text class="zoom-note">点击图片可放大查看每格色号</text><view class="usage"><view wx:for="{{result.usage}}" wx:key="code" class="usage-item"><view class="swatch" style="background:{{item.hex}}"></view><text>{{item.code}}</text><text class="usage-count">{{item.quantity}} 颗</text></view></view><input class="name-input" placeholder="给图纸起个名字" value="{{patternName}}" bindinput="onNameInput"/><button class="primary-button" bindtap="confirm">确认并保存到图纸库</button></view>
<view wx:if="{{recentPatterns.length}}" class="recent-section"><text class="section-title">最近保存</text><view wx:for="{{recentPatterns}}" wx:key="id" class="recent-item" data-id="{{item.id}}" bindtap="openPattern"><text>{{item.name}}</text><text class="recent-meta">{{item.totalBeads}} 颗 · {{item.colorCount}} 色</text></view></view></block></block></view>
