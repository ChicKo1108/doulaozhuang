<view class="page">
  <view wx:if="{{!isLoggedIn}}" class="login-gate"><view class="upload-icon"><image src="/assets/icons/user-round.png" mode="aspectFit" /></view><text class="section-title">请先登录</text><text class="section-caption">登录后即可转换、保存和同步图纸。</text><button class="primary-button" bindtap="retryLogin">微信登录</button><text wx:if="{{loginError}}" class="login-error">{{loginError}}</text></view>
  <block wx:else>
  <view class="page-heading"><text class="eyebrow">图纸工作台</text><text class="title">图片转图纸</text><text class="subtitle">以 Mard 221 色标准，把灵感落成可拼的像素图。</text></view>

  <view class="upload-card">
    <view class="upload-icon"><image src="/assets/icons/image-plus.png" mode="aspectFit" /></view>
    <view class="upload-copy"><text class="upload-title">导入一张图片</text><text class="upload-note">系统将生成 32 × 32 的拼豆图纸</text></view>
    <button class="upload-button" bindtap="chooseImage" loading="{{isConverting}}">{{sourcePath ? '重新选择' : '选择图片'}}</button>
  </view>

  <view wx:if="{{sourcePath}}" class="card source-card"><image class="source-image" src="{{sourcePath}}" mode="aspectFill" /><canvas type="2d" id="conversionCanvas" class="conversion-canvas"></canvas></view>

  <view wx:if="{{cells.length}}" class="card preview-card">
    <view class="section-heading"><view><text class="section-title">图纸预览</text><text class="section-caption">{{gridSize}} × {{gridSize}} 格 · {{actualColorCount}} 色 · {{totalBeads}} 颗</text></view><image class="heading-icon" src="/assets/icons/sparkles.png" mode="aspectFit" /></view>
    <view class="pattern-grid"><view wx:for="{{cells}}" wx:key="index" class="pattern-cell" style="background-color: {{item.hex}};"></view></view>
    <input class="name-input" placeholder="给这张图纸起个名字" value="{{patternName}}" bindinput="onNameInput" />
    <button class="primary-button" bindtap="saveCurrentPattern">保存到我的图纸</button>
  </view>

  <view wx:if="{{recentPatterns.length}}" class="recent-section"><text class="section-title">最近保存</text><view wx:for="{{recentPatterns}}" wx:key="id" class="recent-item"><text>{{item.name}}</text><text class="recent-meta">{{item.totalBeads}} 颗 · {{item.colorCount}} 色</text></view></view>
  </block>
</view>
