.page { min-height: 100vh; padding: 40rpx 28rpx 56rpx; background: var(--color-page); }
.eyebrow, .title, .subtitle, .upload-title, .upload-note, .section-title, .section-caption, .recent-meta { display: block; }
.eyebrow { color: var(--color-accent); font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; }
.title { margin-top: 14rpx; color: var(--color-text); font-size: 52rpx; font-weight: 700; letter-spacing: -1rpx; }
.subtitle { margin-top: 12rpx; color: var(--color-text-muted); font-size: 26rpx; line-height: 1.6; }
.upload-card, .card, .recent-section { border: 1rpx solid var(--color-border); border-radius: var(--radius-lg); background: var(--color-surface); box-shadow: var(--shadow-card); }
.upload-card { display: flex; align-items: center; gap: 20rpx; margin-top: 36rpx; padding: 28rpx; }
.upload-icon { display: flex; flex: none; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; border-radius: var(--radius-sm); background: var(--color-accent-soft); }.upload-icon image { width: 42rpx; height: 42rpx; }
.upload-copy { flex: 1; min-width: 0; }.upload-title { color: var(--color-text); font-size: 29rpx; font-weight: 700; }.upload-note { margin-top: 8rpx; color: var(--color-text-muted); font-size: 22rpx; line-height: 1.45; }
.upload-button, .primary-button { margin: 0; border-radius: var(--radius-sm); background: var(--color-accent); color: #fff; font-size: 25rpx; font-weight: 600; }.upload-button { flex: none; padding: 0 22rpx; }.upload-button::after, .primary-button::after { border: 0; }
.card, .recent-section { margin-top: 24rpx; padding: 28rpx; }.source-card { padding: 14rpx; }.source-image { display: block; width: 100%; height: 300rpx; border-radius: 20rpx; background: var(--color-surface-subtle); }.conversion-canvas { position: fixed; left: -9999px; top: -9999px; width: 1px; height: 1px; }
.section-heading { display: flex; align-items: center; justify-content: space-between; }.section-title { color: var(--color-text); font-size: 32rpx; font-weight: 700; }.section-caption { margin-top: 9rpx; color: var(--color-text-muted); font-size: 24rpx; }.heading-icon { width: 38rpx; height: 38rpx; }
.pattern-grid { display: grid; grid-template-columns: repeat(32, minmax(0, 1fr)); overflow: hidden; margin-top: 24rpx; border: 1rpx solid var(--color-border); border-radius: 14rpx; }.pattern-cell { aspect-ratio: 1 / 1; min-height: 4rpx; }
.name-input { margin-top: 28rpx; padding: 22rpx; border: 1rpx solid var(--color-border); border-radius: var(--radius-sm); background: #fbfcfe; color: var(--color-text); font-size: 27rpx; }.primary-button { height: 88rpx; margin-top: 20rpx; font-size: 28rpx; }
.recent-item { display: flex; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid var(--color-border); color: var(--color-text); font-size: 27rpx; }.recent-item:last-child { border-bottom: 0; }.recent-meta { color: var(--color-text-muted); font-size: 24rpx; }
.login-gate { display:flex; flex-direction:column; align-items:center; padding:180rpx 44rpx 0; text-align:center; }.login-gate .section-title { margin-top:30rpx; }.login-gate .primary-button { width:100%; }
.login-error { margin-top:18rpx; color:var(--color-danger); font-size:23rpx; }
