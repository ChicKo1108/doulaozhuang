.page{min-height:100vh;padding:36rpx 28rpx 70rpx;background:var(--color-page)}.eyebrow,.title,.subtitle,.upload-title,.upload-note,.section-title,.section-caption,.label,.hint,.zoom-note{display:block}.eyebrow{color:var(--color-accent);font-size:22rpx;font-weight:700;letter-spacing:3rpx}.title{margin-top:12rpx;color:var(--color-text);font-size:48rpx;font-weight:750;line-height:1.16}.subtitle{margin-top:14rpx;color:var(--color-text-muted);font-size:25rpx;line-height:1.65}.segmented{display:flex;margin-top:30rpx;padding:6rpx;border:1rpx solid var(--color-border);border-radius:18rpx;background:#eaf0f4}.segment{flex:1;padding:18rpx 10rpx;border-radius:13rpx;text-align:center;color:#607383;font-size:25rpx;font-weight:650}.segment.active{background:#fff;color:#214e70;box-shadow:0 5rpx 18rpx rgba(32,72,102,.1)}.upload-card,.card,.recent-section{border:1rpx solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface);box-shadow:var(--shadow-card)}.upload-card{display:flex;align-items:center;gap:18rpx;margin-top:20rpx;padding:24rpx}.assistant-mark{display:flex;flex:none;align-items:center;justify-content:center;width:76rpx;height:76rpx;border-radius:24rpx;background:linear-gradient(145deg,#d9ebf5,#b7d4e6);color:#245b80;font-size:24rpx;font-weight:800}.upload-copy{flex:1;min-width:0}.upload-title{font-size:28rpx;font-weight:700;color:var(--color-text)}.upload-note{margin-top:7rpx;color:var(--color-text-muted);font-size:21rpx;line-height:1.4}.upload-button,.primary-button{margin:0;border-radius:15rpx;background:var(--color-accent);color:#fff;font-size:25rpx;font-weight:650}.upload-button{padding:0 22rpx}.upload-button::after,.primary-button::after{border:0}.card,.recent-section{margin-top:22rpx;padding:26rpx}.source-card{padding:12rpx}.source-image{display:block;width:100%;height:320rpx;border-radius:18rpx;background:#eef2f4}.section-title{color:var(--color-text);font-size:31rpx;font-weight:720}.section-caption{margin-top:8rpx;color:var(--color-text-muted);font-size:23rpx}.label{margin-top:28rpx;margin-bottom:13rpx;color:#506577;font-size:23rpx;font-weight:650}.choice-row{display:flex;flex-wrap:wrap;gap:12rpx}.choice{padding:15rpx 18rpx;border:1rpx solid #c9d5dd;border-radius:13rpx;color:#506577;font-size:23rpx}.choice.selected{border-color:#2d6f9f;background:#e7f2f8;color:#20587e;font-weight:700}.switch-row{display:flex;align-items:center;justify-content:space-between;margin-top:22rpx;padding-top:22rpx;border-top:1rpx solid var(--color-border);color:var(--color-text);font-size:26rpx}.hint{margin-top:6rpx;color:var(--color-text-muted);font-size:20rpx}.primary-button{height:88rpx;margin-top:25rpx}.section-heading{display:flex;align-items:center;justify-content:space-between}.mirror-badge{padding:8rpx 13rpx;border-radius:99rpx;background:#e7f2f8;color:#245f87;font-size:20rpx}.result-tabs{margin-top:22rpx}.result-image{display:block;width:100%;max-height:950rpx;margin-top:18rpx;border:1rpx solid #d2dce2;border-radius:14rpx;background:#fff}.zoom-note{text-align:center;margin-top:10rpx;color:var(--color-text-muted);font-size:21rpx}.usage{margin-top:22rpx;max-height:380rpx;overflow:auto;border-top:1rpx solid var(--color-border)}.usage-item{display:flex;align-items:center;gap:13rpx;padding:15rpx 2rpx;border-bottom:1rpx solid var(--color-border);font-size:24rpx}.swatch{width:27rpx;height:27rpx;border:1rpx solid #a9b5bd;border-radius:7rpx}.usage-count{margin-left:auto;color:var(--color-text-muted)}.name-input{margin-top:24rpx;padding:21rpx;border:1rpx solid var(--color-border);border-radius:14rpx;background:#fbfcfe;font-size:26rpx}.recent-item{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid var(--color-border);font-size:26rpx}.recent-meta{color:var(--color-text-muted);font-size:23rpx}.login-gate{display:flex;flex-direction:column;align-items:center;padding:180rpx 44rpx 0;text-align:center}.login-gate .section-title{margin-top:26rpx}.login-gate .primary-button{width:100%}
