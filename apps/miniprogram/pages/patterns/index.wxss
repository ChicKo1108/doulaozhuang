.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
  background: #fff9f0;
}

.hero-card,
.card,
.recent-section {
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(84, 57, 39, 0.07);
}

.hero-card {
  padding: 40rpx;
  background: #694c3a;
  color: #fff9f0;
}

.eyebrow,
.title,
.subtitle,
.section-title,
.section-caption,
.recent-meta {
  display: block;
}

.eyebrow { font-size: 23rpx; letter-spacing: 4rpx; opacity: 0.72; }
.title { margin-top: 10rpx; font-size: 50rpx; font-weight: 700; }
.subtitle { margin-top: 14rpx; font-size: 27rpx; line-height: 1.55; opacity: 0.9; }

.primary-button {
  margin-top: 28rpx;
  border-radius: 16rpx;
  background: #d99b55;
  color: #fff;
  font-size: 28rpx;
}
.primary-button::after { border: 0; }

.card,
.recent-section { margin-top: 26rpx; padding: 28rpx; }
.source-image { display: block; width: 100%; height: 300rpx; border-radius: 18rpx; }
.conversion-canvas { position: fixed; left: -9999px; top: -9999px; width: 1px; height: 1px; }
.section-title { color: #3b2d24; font-size: 32rpx; font-weight: 700; }
.section-caption { margin-top: 10rpx; color: #887c72; font-size: 24rpx; }

.pattern-grid {
  display: grid;
  grid-template-columns: repeat(32, minmax(0, 1fr));
  overflow: hidden;
  margin-top: 24rpx;
  border: 1rpx solid #e7ddd1;
  border-radius: 14rpx;
}
.pattern-cell { aspect-ratio: 1 / 1; min-height: 4rpx; }
.name-input { margin-top: 28rpx; padding: 20rpx; border-radius: 16rpx; background: #f7f0e7; font-size: 27rpx; }
.recent-item { display: flex; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #f1e9e1; color: #45342a; font-size: 27rpx; }
.recent-meta { color: #887c72; font-size: 24rpx; }
