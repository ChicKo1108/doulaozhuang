<view class="page">
  <view class="profile-card">
    <view class="avatar">豆</view>
    <view><text class="title">我的豆老庄</text><text class="copy">本地拼豆管理空间</text></view>
  </view>
  <view class="stats-card"><view><text class="stat-number">{{patternCount}}</text><text class="stat-label">图纸</text></view><view><text class="stat-number">{{inventoryCount}}</text><text class="stat-label">豆子颜色</text></view></view>
  <view class="setting-card"><text class="setting-label">当前豆子库</text><text class="setting-value">{{vaultName}}</text></view>
  <button class="clear-button" bindtap="clearData">清除本地测试数据</button>
</view>
