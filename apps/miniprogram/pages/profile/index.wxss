.page { min-height: 100vh; padding: 40rpx 28rpx 56rpx; background: var(--color-page); }.profile-card, .stats-card, .setting-card { border: 1rpx solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); box-shadow: var(--shadow-card); }.profile-card { display: flex; align-items: center; padding: 30rpx; }.avatar { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; margin-right: 22rpx; border-radius: 28rpx; background: var(--color-accent-soft); }.avatar image { width: 44rpx; height: 44rpx; }.title, .copy, .eyebrow, .stat-number, .stat-label, .setting-label, .setting-value { display: block; }.eyebrow { color: var(--color-accent); font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }.title { margin-top: 7rpx; color: var(--color-text); font-size: 34rpx; font-weight: 700; }.copy, .stat-label, .setting-label { margin-top: 7rpx; color: var(--color-text-muted); font-size: 24rpx; }.stats-card { display: flex; align-items: center; justify-content: space-around; margin-top: 24rpx; padding: 28rpx; text-align: center; }.stat { flex: 1; }.divider { width: 1rpx; height: 56rpx; background: var(--color-border); }.stat-number { color: var(--color-accent); font-size: 50rpx; font-weight: 700; }.setting-card { display: flex; align-items: center; gap: 18rpx; margin-top: 24rpx; padding: 26rpx; }.setting-icon { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; border-radius: 20rpx; background: var(--color-surface-subtle); }.setting-icon image { width: 36rpx; height: 36rpx; }.setting-value { margin-top: 8rpx; color: var(--color-text); font-size: 28rpx; font-weight: 600; }.clear-button { display: flex; align-items: center; justify-content: center; gap: 10rpx; height: 80rpx; margin-top: 32rpx; border: 1rpx solid #fecdd3; border-radius: var(--radius-sm); background: #fff; color: var(--color-danger); font-size: 27rpx; }.clear-button::after { border: 0; }.clear-button image { width: 32rpx; height: 32rpx; }
