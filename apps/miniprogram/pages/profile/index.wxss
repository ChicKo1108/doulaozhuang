.page { min-height: 100vh; padding: 32rpx 28rpx; background: #fff9f0; }.profile-card,.stats-card,.setting-card { display: flex; align-items: center; padding: 30rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(84,57,39,.06); }.avatar { display: flex; align-items: center; justify-content: center; width: 84rpx; height: 84rpx; margin-right: 22rpx; border-radius: 50%; background: #694c3a; color: #fff; font-size: 35rpx; font-weight: 700; }.title,.copy,.stat-number,.stat-label,.setting-label,.setting-value { display: block; }.title { color: #3b2d24; font-size: 33rpx; font-weight: 700; }.copy,.stat-label,.setting-label { margin-top: 7rpx; color: #887c72; font-size: 24rpx; }.stats-card { justify-content: space-around; margin-top: 24rpx; text-align: center; }.stat-number { color: #694c3a; font-size: 48rpx; font-weight: 700; }.setting-card { display: block; margin-top: 24rpx; }.setting-value { margin-top: 13rpx; color: #3b2d24; font-size: 28rpx; }.clear-button { margin-top: 32rpx; border-radius: 16rpx; background: #f4e3df; color: #ad524a; font-size: 27rpx; }.clear-button::after { border: 0; }
