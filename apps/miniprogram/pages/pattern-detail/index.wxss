.page{min-height:100vh;padding:30rpx 28rpx 70rpx;background:var(--color-page)}.loading{padding-top:240rpx;text-align:center;color:var(--color-text-muted);font-size:26rpx}.hero{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx}.eyebrow,.title,.meta,.section-title,.section-note,.zoom{display:block}.eyebrow{color:#2d6f9f;font-size:22rpx;font-weight:750;letter-spacing:3rpx}.title{margin-top:12rpx;color:var(--color-text);font-size:46rpx;font-weight:760;line-height:1.18}.meta{margin-top:13rpx;color:var(--color-text-muted);font-size:23rpx}.rename{flex:none;margin:3rpx 0 0;padding:0 22rpx;border:1rpx solid #b8cad6;border-radius:99rpx;background:#fff;color:#315b77;font-size:23rpx}.rename::after,.status-button::after{border:0}.sheet-card,.status-card,.usage-card{margin-top:28rpx;padding:22rpx;border:1rpx solid var(--color-border);border-radius:25rpx;background:#fff;box-shadow:var(--shadow-card)}.tabs{display:flex;padding:5rpx;border-radius:15rpx;background:#eaf0f4}.tab{flex:1;padding:16rpx;text-align:center;color:#607383;font-size:24rpx}.tab.active{border-radius:11rpx;background:#fff;color:#214e70;font-weight:700;box-shadow:0 4rpx 12rpx rgba(32,72,102,.09)}.sheet{display:block;width:100%;max-height:1100rpx;margin-top:18rpx;border-radius:15rpx;background:#f5f7f8}.zoom{margin-top:11rpx;text-align:center;color:var(--color-text-muted);font-size:21rpx}.section-title{font-size:29rpx;font-weight:730;color:var(--color-text)}.section-note{margin-top:8rpx;color:var(--color-text-muted);font-size:22rpx}.status-actions{display:flex;gap:12rpx;margin-top:20rpx}.status-button{flex:1;margin:0;padding:0;border:1rpx solid #c6d4dd;border-radius:14rpx;background:#f8fafb;color:#536979;font-size:23rpx}.status-button.selected{border-color:#2d6f9f;background:#e2f0f7;color:#20587e;font-weight:700}.status-button.completed.selected{border-color:#4d8069;background:#e5f2eb;color:#35654f}.usage-row{display:flex;align-items:center;padding:18rpx 0;border-bottom:1rpx solid var(--color-border);font-size:24rpx;color:#536979}.usage-row:last-child{border-bottom:0}.code{font-weight:700;color:#243746}.usage-line{flex:1;margin:0 18rpx;border-top:1rpx dashed #ccd6dc}
.dialog-mask{position:fixed;z-index:1000;inset:0;display:flex;align-items:flex-end;justify-content:center;padding:36rpx 24rpx;background:rgba(48,24,14,.62);box-sizing:border-box}.complete-dialog{position:relative;width:100%;max-height:82vh;padding:44rpx 30rpx 30rpx;border:5rpx solid #6f3820;border-radius:34rpx 34rpx 22rpx 22rpx;background:#fff8e8;box-shadow:inset 0 0 0 4rpx #d9aa69,0 22rpx 60rpx rgba(52,25,13,.34);box-sizing:border-box}.dialog-beads{position:absolute;top:-19rpx;left:50%;display:flex;gap:8rpx;transform:translateX(-50%)}.dialog-beads i{display:block;width:28rpx;height:28rpx;border:4rpx solid #6f3820;border-radius:50%;background:#f6b916;box-shadow:inset 0 4rpx 0 rgba(255,255,255,.55)}.dialog-beads i:nth-child(2),.dialog-beads i:nth-child(4){background:#168c88}.dialog-beads i:nth-child(3){background:#c93d24}.dialog-kicker,.dialog-title,.dialog-copy,.vault-name,.vault-note,.vault-selected,.complete-error text{display:block}.dialog-kicker{text-align:center;color:#a83320;font-size:21rpx;font-weight:750;letter-spacing:3rpx}.dialog-title{margin-top:10rpx;text-align:center;color:#3b2116;font-size:38rpx;font-weight:800}.dialog-copy{margin-top:18rpx;color:#73523f;font-size:24rpx;line-height:1.65}.dialog-copy b{color:#c93d24;font-size:30rpx}.vault-list{max-height:390rpx;margin-top:24rpx}.vault-option{display:flex;align-items:center;gap:18rpx;margin-bottom:14rpx;padding:20rpx;border:2rpx solid #dec6a3;border-radius:18rpx;background:#fffdf7}.vault-option.selected{border-color:#168c88;background:#e8f5ef;box-shadow:inset 0 0 0 2rpx rgba(22,140,136,.14)}.radio{display:flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;border:3rpx solid #b58e69;border-radius:50%;box-sizing:border-box}.vault-option.selected .radio{border-color:#168c88}.radio-dot{width:17rpx;height:17rpx;border-radius:50%;background:transparent}.vault-option.selected .radio-dot{background:#168c88}.vault-copy{flex:1;min-width:0}.vault-name{overflow:hidden;color:#3b2116;font-size:27rpx;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.vault-note{margin-top:5rpx;color:#8a6a55;font-size:20rpx}.vault-selected{color:#168c88;font-size:21rpx;font-weight:700}.complete-error{margin-top:16rpx;padding:16rpx 18rpx;border:2rpx solid #d79a8c;border-radius:14rpx;background:#fff0ea;color:#a43124;font-size:22rpx;line-height:1.5}.dialog-actions{display:flex;gap:16rpx;margin-top:26rpx}.dialog-cancel,.dialog-confirm{height:82rpx;margin:0;border-radius:16rpx;font-size:25rpx;font-weight:750;line-height:82rpx}.dialog-cancel{width:190rpx;border:2rpx solid #cdb394;background:#fffaf0;color:#71513f}.dialog-confirm{flex:1;border:3rpx solid #7b351f;background:linear-gradient(#dc5032,#bd351f);color:#fff;box-shadow:inset 0 2rpx 0 rgba(255,255,255,.32),0 5rpx 0 #7b351f}.dialog-cancel::after,.dialog-confirm::after{border:0}.dialog-confirm[disabled]{opacity:.62}.status-button[disabled]{opacity:1}
