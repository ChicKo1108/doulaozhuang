<view class="page">
  <view class="topbar">
    <view>
      <text class="eyebrow">豆老庄</text>
      <text class="title">我的图纸</text>
      <text class="subtitle">已收藏 {{totalPatterns}} 张拼豆图纸</text>
    </view>
    <button class="add-button" bindtap="goToPatterns">＋</button>
  </view>

  <view wx:if="{{totalPatterns}}" class="waterfall">
    <view class="waterfall-column">
      <view wx:for="{{leftPatterns}}" wx:key="id" class="pattern-card">
        <image wx:if="{{item.coverPath}}" class="pattern-cover" src="{{item.coverPath}}" mode="widthFix" />
        <view wx:else class="pattern-placeholder">{{item.colorCount}} 色</view>
        <view class="card-copy">
          <text class="pattern-name">{{item.name}}</text>
          <text class="pattern-meta">Mard 221 · {{item.totalBeads}} 颗</text>
        </view>
      </view>
    </view>
    <view class="waterfall-column">
      <view wx:for="{{rightPatterns}}" wx:key="id" class="pattern-card">
        <image wx:if="{{item.coverPath}}" class="pattern-cover" src="{{item.coverPath}}" mode="widthFix" />
        <view wx:else class="pattern-placeholder">{{item.colorCount}} 色</view>
        <view class="card-copy">
          <text class="pattern-name">{{item.name}}</text>
          <text class="pattern-meta">Mard 221 · {{item.totalBeads}} 颗</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:else class="empty-state">
    <view class="empty-illustration">⌘</view>
    <text class="empty-title">还没有图纸</text>
    <text class="empty-copy">去图纸库上传一张图片，系统会自动生成 Mard 221 色拼豆图纸。</text>
    <button class="primary-button" bindtap="goToPatterns">去创建第一张图纸</button>
  </view>
</view>
