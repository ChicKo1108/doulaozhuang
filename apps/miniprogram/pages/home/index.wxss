.page {
  padding: 48rpx 32rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 48rpx 40rpx;
  border-radius: 32rpx;
  background: #694c3a;
  color: #fff9f0;
}

.eyebrow {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  opacity: 0.72;
}

.title {
  font-size: 64rpx;
  font-weight: 700;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.9;
}

.notice {
  margin-top: 32rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.notice-title,
.notice-copy {
  display: block;
}

.notice-title {
  font-size: 32rpx;
  font-weight: 600;
}

.notice-copy {
  margin-top: 12rpx;
  color: #756b62;
  font-size: 26rpx;
  line-height: 1.6;
}
