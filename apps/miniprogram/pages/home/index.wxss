.page {
  min-height: 100vh;
  padding: 36rpx 28rpx 48rpx;
  background: #fff9f0;
}

.topbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 0 8rpx 32rpx;
}

.eyebrow,
.title,
.subtitle,
.pattern-name,
.pattern-meta,
.empty-title,
.empty-copy {
  display: block;
}

.eyebrow {
  color: #a47c61;
  font-size: 24rpx;
  letter-spacing: 4rpx;
}

.title {
  margin-top: 8rpx;
  color: #32261e;
  font-size: 54rpx;
  font-weight: 700;
}

.subtitle,
.pattern-meta,
.empty-copy {
  margin-top: 10rpx;
  color: #887c72;
  font-size: 25rpx;
}

.add-button {
  width: 76rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #694c3a;
  color: #fff;
  font-size: 48rpx;
  line-height: 70rpx;
}

.add-button::after,
.primary-button::after {
  border: 0;
}

.waterfall {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.waterfall-column {
  flex: 1;
  min-width: 0;
}

.pattern-card {
  overflow: hidden;
  margin-bottom: 20rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 8rpx 28rpx rgba(84, 57, 39, 0.07);
}

.pattern-cover {
  display: block;
  width: 100%;
  min-height: 220rpx;
  background: #eee0d2;
}

.pattern-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 250rpx;
  background: linear-gradient(135deg, #d7b59c, #f7dfc5);
  color: #694c3a;
  font-size: 40rpx;
  font-weight: 700;
}

.card-copy {
  padding: 20rpx;
}

.pattern-name {
  overflow: hidden;
  color: #3b2d24;
  font-size: 28rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 156rpx 40rpx 0;
  text-align: center;
}

.empty-illustration {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  border-radius: 42rpx;
  background: #f2e3d3;
  color: #a47c61;
  font-size: 72rpx;
}

.empty-title {
  margin-top: 28rpx;
  color: #3b2d24;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 18rpx;
  line-height: 1.65;
}

.primary-button {
  margin-top: 38rpx;
  padding: 0 36rpx;
  border-radius: 16rpx;
  background: #694c3a;
  color: #fff;
  font-size: 28rpx;
}
