{
  "name": "doulaozhuang",
  "version": "0.1.0",
  "private": true,
  "description": "豆老庄微信小程序与 API 服务",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run start:dev --workspace=@doulaozhuang/api",
    "build:api": "npm run build --workspace=@doulaozhuang/api",
